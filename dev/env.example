# API Configuration
API_ENDPOINT=http://localhost:9001/v1/chat/completions

# Dataset Configuration
LANG=sw
DATASET_NAME=HuggingFaceFW/fineweb-edu
SUBSET_NAME=sample-10BT
SPLIT=train
TEXT_COLUMN=text
RAW_DATA_PATH=/raid/.tnp/fineweb_edu_raw
LOCAL_SAVE_PATH=/raid/.tnp/fineweb_edu_translated
FINAL_PARQUET_PATH=/raid/.tnp/fineweb_edu_final.parquet

# Performance Settings
BATCH_SIZE=2048
MAX_RETRIES=5
BASE_DELAY=2
CHUNK_SIZE=50000

# Docker Settings
HEALTH_CHECK_PORT=8000